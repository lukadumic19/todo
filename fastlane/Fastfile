# Bygger iOS-appen og sender den til TestFlight (kun intern test).
# Køres af GitHub Actions (.github/workflows/testflight.yml) på en Mac i skyen.
default_platform(:ios)

platform :ios do
  desc "Byg og upload til TestFlight"
  lane :beta do
    setup_ci

    key_id    = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_path  = ENV.fetch("ASC_KEY_PATH")
    team_id   = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # Nyt buildnummer: ét højere end det seneste på TestFlight.
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1

    # Apple klarer certifikater og profiler selv (cloud signing) via API-nøglen.
    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer_id}"

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Automatic CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth,
      export_options: { signingStyle: "automatic", teamID: team_id },
      output_directory: "build",
      output_name: "Opgaver.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
