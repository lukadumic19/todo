{
  "name": "opgaver",
  "version": "1.0.0",
  "private": true,
  "description": "Opgaver – pakket som iOS-app med Capacitor",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:assets": "npx capacitor-assets generate --ios --iconBackgroundColor #F2F0EB --splashBackgroundColor #F2F0EB --splashBackgroundColorDark #121317"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "htm": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
